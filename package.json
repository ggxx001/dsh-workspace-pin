{
  "name": "@ggxx/dsh-workspace-pin",
  "version": "0.2.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "给侧栏工作区加置顶：工作区行多一个图钉按钮，置顶的排在「工作区」最前。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
